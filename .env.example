# Copy to .env for local dev. In production these are set in the Render and
# Vercel dashboards, not in a file.

# ---- shared: database (Neon) ----
# Use the POOLED connection string. client.ts upgrades sslmode=require to verify-full.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ---- API (Render) ----
AUTH_SECRET=            # 32+ random chars: `openssl rand -base64 32`
API_URL=http://localhost:3001          # prod: https://lm-api.onrender.com
WEB_ORIGIN=http://localhost:3000       # prod: https://lm-web.vercel.app
# PORT is provided by Render automatically; leave unset locally to use 3001.

# ---- AI providers (used by the API) ----
OPENROUTER_API_KEY=
GEMINI_API_KEY=
SCRAPECREATORS_API_KEY=               # optional if LINKEDIN_PROVIDER=manual
LINKEDIN_PROVIDER=scrapecreators      # or: manual
# OPENROUTER_MODEL=minimax/minimax-m3:free   # optional, this is the default
# LINKEDIN_ENRICH_POSTS=5

# ---- Web (Vercel) ----
# API_URL as above. next.config.ts derives NEXT_PUBLIC_WS_URL from it; set it
# explicitly if the API is behind a different host for websockets.
# NEXT_PUBLIC_WS_URL=wss://lm-api.onrender.com
